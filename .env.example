# EmailJS public configuration (these are public-safe keys; never put a private key here)
VITE_EMAILJS_SERVICE_ID=
VITE_EMAILJS_TEMPLATE_ID=
VITE_EMAILJS_PUBLIC_KEY=

# Your deployed site URL (used for canonical + Open Graph URLs)
VITE_SITE_URL=https://YOUR-DOMAIN.com

# Optional: real profile links (placeholders are shown until set)
VITE_LINKEDIN_URL=
VITE_GITHUB_URL=
